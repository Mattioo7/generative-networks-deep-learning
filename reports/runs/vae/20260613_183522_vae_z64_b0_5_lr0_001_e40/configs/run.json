{
  "experiment": "vae",
  "kind": "vae",
  "data": {
    "train_fraction": 0.9,
    "validation_fraction": 0.1,
    "augment_flip": false,
    "seed": 42
  },
  "train": {
    "epochs": 40,
    "batch_size": 64,
    "sample_every": 10
  },
  "model": {
    "latent_dim": 64,
    "beta": 0.5,
    "learning_rate": 0.001,
    "weight_decay": 1e-05,
    "kl_anneal_epochs": 20
  }
}